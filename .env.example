# Environment variable placeholders for optional external integrations.
# Copy this file to .env and fill in real values locally. Never commit .env.
# All variables are optional; the local pipeline must run without them.

# ENTSO-E Transparency Platform API (optional market/grid data ingestion)
ENTSOE_API_KEY=

# AWS (optional artifact mirroring / infrastructure demonstration)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
